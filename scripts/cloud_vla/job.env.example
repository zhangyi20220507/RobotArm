# This file is copied to job.env in each generated package.
# Use absolute paths after the dataset and model assets are present.
POLICY=pi0
# Used by SmolVLA. "expert" is the standard frozen-VLM/action-expert tune;
# "lora" is the lower-memory fallback. Pi0 always uses LoRA in this package.
TRAINING_MODE=lora
DATASET_ROOT=/absolute/path/to/data/lerobot/task_dataset
BASE_CHECKPOINT=/absolute/path/to/artifacts/pretrained/pi0_base
OUTPUT_DIR=/absolute/path/to/artifacts/checkpoints/pi0_task_270eps_lora_v1

BATCH_SIZE=1
STEPS=30000
CHUNK_SIZE=50
N_ACTION_STEPS=20
EVAL_SPLIT=0.1
SAVE_FREQ=2000
EVAL_STEPS=2000
MAX_EVAL_SAMPLES=256
LORA_RANK=16
LORA_ALPHA=32
LEARNING_RATE=0.0001
NUM_WORKERS=4
SEED=1000

# Optional explicit review file. Leave empty when review metadata was already
# applied during the final raw -> LeRobot conversion.
QUALITY_REVIEWS=
MONITOR_PORT=8420
# Set only when resuming from a complete checkpoint; STEPS remains the total target.
RESUME_CONFIG=
