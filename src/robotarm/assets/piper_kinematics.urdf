    <limit lower="-0.0349066" upper="3.1764992" effort="100" velocity="5"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0019663" upper="0.0349066" effort="100" velocity="5"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="-0.02198 -0.25075 0" rpy="1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7278760" upper="1.7278760" effort="100" velocity="5"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2042772" upper="1.2042772" effort="100" velocity="5"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.000088259 -0.091 0" rpy="1.5707963 0 0"/>
