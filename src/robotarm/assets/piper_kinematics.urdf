    <limit lower="-2.6005406" upper="2.6005406" effort="100" velocity="5"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/>
